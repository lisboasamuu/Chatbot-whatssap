generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ConversationState {
  INITIAL
  ACTIVE
  SCHEDULING_DATE
  SCHEDULING_TIME
  SCHEDULING_NAME
  SCHEDULING_CONFIRMATION
  CANCELING_SELECT
  CANCELING_CONFIRMATION
  RESCHEDULING_SELECT
  RESCHEDULING_DATE
  RESCHEDULING_TIME
  RESCHEDULING_CONFIRMATION
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum CompanyStatus {
  ACTIVE
  INACTIVE
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum MessageTemplateType {
  WELCOME
  APPOINTMENT_CREATED
  APPOINTMENT_CANCELLED
  APPOINTMENT_RESCHEDULED
  NO_APPOINTMENTS
  BUSINESS_CLOSED
  REMINDER
}

enum ReminderStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  SKIPPED
}

enum DepositType {
  NONE
  FIXED
  PERCENTAGE
}

enum AutomationType {
  INBOUND
  SCHEDULED
}

enum AutomationScheduleType {
  ONE_TIME
  WEEKLY
}

enum AutomationRunStatus {
  PENDING
  PROCESSING
  COMPLETED
  PARTIAL
  FAILED
}

enum AutomationDeliveryStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  SKIPPED
}

model Company {
  id               String                @id @default(cuid())
  name             String
  status           CompanyStatus         @default(ACTIVE)
  timezone         String                @default("America/Sao_Paulo")
  customers        Customer[]
  settings         CompanySettings?
  credential       CompanyCredential?
  businessHours    BusinessHour[]
  messageTemplates MessageTemplate[]
  reminders        AppointmentReminder[]
  automations      Automation[]
  automationRuns   AutomationRun[]
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@index([status, createdAt])
}

model CompanySettings {
  id               String      @id @default(cuid())
  companyId        String      @unique
  company          Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  pixEnabled       Boolean     @default(false)
  pixKey           String?
  pixRecipientName String?
  depositType      DepositType @default(NONE)
  depositValue     Int?
  remindersEnabled Boolean     @default(false)
  reminderOffsets  Int[]       @default([])
  whatsappEnabled  Boolean     @default(true)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

model BusinessHour {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  weekday   Weekday
  startTime String
  endTime   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, weekday, startTime, endTime])
  @@index([companyId, weekday])
}

model MessageTemplate {
  id        String              @id @default(cuid())
  companyId String
  company   Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  type      MessageTemplateType
  body      String
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@unique([companyId, type])
  @@index([companyId])
}

model Customer {
  id                   String                @id @default(cuid())
  companyId            String
  company              Company               @relation(fields: [companyId], references: [id], onDelete: Restrict)
  externalId           String
  name                 String?
  conversations        Conversation[]
  appointments         Appointment[]
  automationRecipients AutomationRecipient[]
  automationDeliveries AutomationDelivery[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@unique([companyId, externalId])
  @@unique([companyId, id])
  @@index([companyId, createdAt])
}

model Conversation {
  id         String            @id @default(cuid())
  companyId  String
  customerId String
  customer   Customer          @relation(fields: [companyId, customerId], references: [companyId, id], onDelete: Cascade)
  state      ConversationState @default(INITIAL)
  context    Json?
  messages   Message[]
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@unique([companyId, customerId])
  @@unique([companyId, id])
  @@index([companyId, updatedAt])
}

model Message {
  id             String           @id @default(cuid())
  conversationId String
  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction      MessageDirection
  body           String
  createdAt      DateTime         @default(now())

  @@index([conversationId, createdAt])
}

model Appointment {
  id         String   @id @default(cuid())
  companyId  String
  customerId String
  customer   Customer @relation(fields: [companyId, customerId], references: [companyId, id], onDelete: Cascade)
  date       String
  time       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([companyId, date, time])
  @@unique([companyId, id])
  @@index([companyId, customerId, date, time])
}

model AppointmentReminder {
  id                  String         @id @default(cuid())
  companyId           String
  company             Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  appointmentId       String
  offsetMinutes       Int
  scheduledFor        DateTime
  appointmentDate     String
  appointmentTime     String
  status              ReminderStatus @default(PENDING)
  attempts            Int            @default(0)
  nextAttemptAt       DateTime
  processingStartedAt DateTime?
  dispatchStartedAt   DateTime?
  sentAt              DateTime?
  providerMessageId   String?
  lastError           String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@unique([companyId, appointmentId, offsetMinutes, scheduledFor])
  @@index([companyId, status, scheduledFor])
  @@index([companyId, status, nextAttemptAt])
}

model CompanyCredential {
  id           String           @id @default(cuid())
  companyId    String           @unique
  company      Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  email        String           @unique
  passwordHash String
  sessions     CompanySession[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([companyId])
}

model CompanySession {
  id           String            @id @default(cuid())
  credentialId String
  credential   CompanyCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade)
  tokenHash    String            @unique
  createdAt    DateTime          @default(now())
  lastSeenAt   DateTime          @default(now())
  expiresAt    DateTime

  @@index([credentialId, expiresAt])
  @@index([expiresAt])
}

model Automation {
  id                  String                  @id @default(cuid())
  companyId           String
  company             Company                 @relation(fields: [companyId], references: [id], onDelete: Restrict)
  name                String
  type                AutomationType
  isActive            Boolean                 @default(true)
  responseBody        String?
  messageBody         String?
  scheduleType        AutomationScheduleType?
  oneTimeDate         String?
  oneTimeTime         String?
  weekdays            Weekday[]               @default([])
  times               String[]                @default([])
  nextRunAt           DateTime?
  scheduleVersion     Int                     @default(1)
  processingStartedAt DateTime?
  deletedAt           DateTime?
  variations          AutomationVariation[]
  recipients          AutomationRecipient[]
  runs                AutomationRun[]
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  @@unique([companyId, id])
  @@index([companyId, type, isActive, deletedAt])
  @@index([companyId, nextRunAt, processingStartedAt])
}

model AutomationVariation {
  id              String     @id @default(cuid())
  companyId       String
  automationId    String
  automation      Automation @relation(fields: [companyId, automationId], references: [companyId, id], onDelete: Cascade)
  value           String
  normalizedValue String
  createdAt       DateTime   @default(now())

  @@unique([automationId, normalizedValue])
  @@index([companyId, automationId])
}

model AutomationRecipient {
  id           String     @id @default(cuid())
  companyId    String
  automationId String
  customerId   String
  automation   Automation @relation(fields: [companyId, automationId], references: [companyId, id], onDelete: Cascade)
  customer     Customer   @relation(fields: [companyId, customerId], references: [companyId, id], onDelete: Restrict)
  createdAt    DateTime   @default(now())

  @@unique([automationId, customerId])
  @@index([companyId, automationId])
  @@index([companyId, customerId])
}

model AutomationRun {
  id              String               @id @default(cuid())
  companyId       String
  automationId    String
  company         Company              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  automation      Automation           @relation(fields: [companyId, automationId], references: [companyId, id], onDelete: Restrict)
  scheduleVersion Int
  scheduledFor    DateTime
  status          AutomationRunStatus  @default(PENDING)
  totalRecipients Int                  @default(0)
  sentCount       Int                  @default(0)
  failedCount     Int                  @default(0)
  startedAt       DateTime?
  completedAt     DateTime?
  deliveries      AutomationDelivery[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@unique([companyId, id])
  @@unique([automationId, scheduleVersion, scheduledFor])
  @@index([companyId, status, scheduledFor])
}

model AutomationDelivery {
  id                  String                   @id @default(cuid())
  companyId           String
  runId               String
  customerId          String
  run                 AutomationRun            @relation(fields: [companyId, runId], references: [companyId, id], onDelete: Cascade)
  customer            Customer                 @relation(fields: [companyId, customerId], references: [companyId, id], onDelete: Restrict)
  recipient           String
  recipientName       String?
  body                String
  status              AutomationDeliveryStatus @default(PENDING)
  attempts            Int                      @default(0)
  nextAttemptAt       DateTime
  processingStartedAt DateTime?
  dispatchStartedAt   DateTime?
  sentAt              DateTime?
  providerMessageId   String?
  lastError           String?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  @@unique([runId, customerId])
  @@index([companyId, status, nextAttemptAt])
  @@index([companyId, runId, status])
}
