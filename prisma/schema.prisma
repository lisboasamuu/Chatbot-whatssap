generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ConversationState {
  INITIAL
  ACTIVE
  SCHEDULING_DATE
  SCHEDULING_TIME
  SCHEDULING_NAME
  SCHEDULING_CONFIRMATION
  CANCELING_SELECT
  CANCELING_CONFIRMATION
  RESCHEDULING_SELECT
  RESCHEDULING_DATE
  RESCHEDULING_TIME
  RESCHEDULING_CONFIRMATION
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum CompanyStatus {
  ACTIVE
  INACTIVE
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum MessageTemplateType {
  WELCOME
  APPOINTMENT_CREATED
  APPOINTMENT_CANCELLED
  APPOINTMENT_RESCHEDULED
  NO_APPOINTMENTS
  BUSINESS_CLOSED
  REMINDER
}

enum ReminderStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  SKIPPED
}

enum DepositType {
  NONE
  FIXED
  PERCENTAGE
}

model Company {
  id               String                @id @default(cuid())
  name             String
  status           CompanyStatus         @default(ACTIVE)
  timezone         String                @default("America/Sao_Paulo")
  customers        Customer[]
  settings         CompanySettings?
  businessHours    BusinessHour[]
  messageTemplates MessageTemplate[]
  reminders        AppointmentReminder[]
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@index([status, createdAt])
}

model CompanySettings {
  id               String      @id @default(cuid())
  companyId        String      @unique
  company          Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  pixEnabled       Boolean     @default(false)
  pixKey           String?
  pixRecipientName String?
  depositType      DepositType @default(NONE)
  depositValue     Int?
  remindersEnabled Boolean     @default(false)
  reminderOffsets  Int[]       @default([])
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

model BusinessHour {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  weekday   Weekday
  startTime String
  endTime   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, weekday, startTime, endTime])
  @@index([companyId, weekday])
}

model MessageTemplate {
  id        String              @id @default(cuid())
  companyId String
  company   Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  type      MessageTemplateType
  body      String
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@unique([companyId, type])
  @@index([companyId])
}

model Customer {
  id            String         @id @default(cuid())
  companyId     String
  company       Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  externalId    String
  name          String?
  conversations Conversation[]
  appointments  Appointment[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([companyId, externalId])
  @@unique([companyId, id])
  @@index([companyId, createdAt])
}

model Conversation {
  id         String            @id @default(cuid())
  companyId  String
  customerId String
  customer   Customer          @relation(fields: [companyId, customerId], references: [companyId, id], onDelete: Cascade)
  state      ConversationState @default(INITIAL)
  context    Json?
  messages   Message[]
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@unique([companyId, customerId])
  @@unique([companyId, id])
  @@index([companyId, updatedAt])
}

model Message {
  id             String           @id @default(cuid())
  conversationId String
  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction      MessageDirection
  body           String
  createdAt      DateTime         @default(now())

  @@index([conversationId, createdAt])
}

model Appointment {
  id         String   @id @default(cuid())
  companyId  String
  customerId String
  customer   Customer @relation(fields: [companyId, customerId], references: [companyId, id], onDelete: Cascade)
  date       String
  time       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([companyId, date, time])
  @@unique([companyId, id])
  @@index([companyId, customerId, date, time])
}

model AppointmentReminder {
  id                  String         @id @default(cuid())
  companyId           String
  company             Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  appointmentId       String
  offsetMinutes       Int
  scheduledFor        DateTime
  appointmentDate     String
  appointmentTime     String
  status              ReminderStatus @default(PENDING)
  attempts            Int            @default(0)
  nextAttemptAt       DateTime
  processingStartedAt DateTime?
  dispatchStartedAt   DateTime?
  sentAt              DateTime?
  providerMessageId   String?
  lastError           String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@unique([companyId, appointmentId, offsetMinutes, scheduledFor])
  @@index([companyId, status, scheduledFor])
  @@index([companyId, status, nextAttemptAt])
}
